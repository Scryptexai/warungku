# ==========================================================================
# Warungku — Contoh Konfigurasi Environment
#
# Salin file ini menjadi ".env.local" untuk pengembangan lokal:
#   cp .env.example .env.local
#
# ATURAN KEAMANAN:
# - JANGAN pernah commit file .env* yang berisi kredensial asli ke repo.
# - JANGAN pernah menaruh kredensial langsung di dalam kode sumber.
# - Variabel TANPA prefiks NEXT_PUBLIC_ hanya boleh dibaca di server.
# ==========================================================================

# --------------------------------------------------------------------------
# APLIKASI (publik — aman untuk browser karena berprefiks NEXT_PUBLIC_)
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Warungku"

# development | test | production
NEXT_PUBLIC_APP_ENV="development"

# URL dasar aplikasi (dipakai untuk menyusun redirect OAuth pada Tahap 2).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NEXT_PUBLIC_DEFAULT_CURRENCY="IDR"
NEXT_PUBLIC_DEFAULT_LOCALE="id-ID"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Jakarta"

# --------------------------------------------------------------------------
# GOOGLE — DIPAKAI MULAI TAHAP 2 (Google OAuth & Google Sheets)
#
# Cara pembuatan (Tahap 2):
#   1. Buat proyek di Google Cloud Console.
#   2. Aktifkan Google Sheets API + Google Drive API.
#   3. Konfigurasikan OAuth consent screen.
#   4. Buat OAuth Client ID bertipe "Web application".
# --------------------------------------------------------------------------
# GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# URI redirect OAuth. Nilai default disusun dari NEXT_PUBLIC_APP_URL:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Kunci untuk mengenkripsi refresh token yang disimpan di server
# (panjang minimal 32 karakter). Dibutuhkan mulai Tahap 2.
# GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --------------------------------------------------------------------------
# TAHAP 7 — data contoh (mock) untuk validasi menyeluruh
# --------------------------------------------------------------------------
# NEXT_PUBLIC_ENABLE_MOCK_DATA="false"
